{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A scatterplot showing body mass and flipper lengths of penguins.",
  "title": {
    "text": "Big penguins have big flippers",
    "subtitle": "Comparing the body mass and flipper lengths of 3 spieces of penguins"},
  "data": {
    "url": "data/penguins.json"
  },
  "mark": "circle",
  "encoding": {
    "y": {
      "field": "Flipper Length (mm)",
      "type": "quantitative",
      "scale": {"zero": false}
    },
    "x": {
      "field": "Body Mass (g)",
      "type": "quantitative",
      "scale": {"zero": false}
    },
    "color": {
      "field": "Species", 
      "type": "nominal",
      "scale": {"domain": ["Adelie", "Chinstrap", "Gentoo"],
    "range": ["#C85F00", "#09598A", "#EAB805"]}
      },
    "shape": {"field": "Species", "type": "nominal"}
  }
}
